# 高德开放平台「Web端(JS API)」Key，申请地址：https://console.amap.com/dev/key/app
# 本地开发：写入 .env.local；公网部署：写入 Cloudflare Pages 项目的环境变量。
NEXT_PUBLIC_AMAP_KEY=

# 与 Key 配套的安全密钥。默认以高德官方支持的前端方式使用；
# 如需密钥不进前端，请部署 Cloudflare Worker 代理并改用下方 AMAP_SERVICE_HOST。
AMAP_SECURITY_CODE=

# 可选：Cloudflare Worker 代理地址（形如 https://xxx.workers.dev/_AMapService）。
# 配置后前端走 serviceHost 代理，AMAP_SECURITY_CODE 不再进入前端包。
AMAP_SERVICE_HOST=

# 可选：本地端口，默认 3000；被占用时启动脚本自动选择空闲端口。
PORT=3000
