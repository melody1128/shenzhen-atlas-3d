# 高德开放平台「Web端(JS API)」Key，申请地址：https://console.amap.com/dev/key/app
# 本地开发：写入 .env.local；公网部署：写入 Cloudflare Pages 项目的环境变量。
NEXT_PUBLIC_AMAP_KEY=

# 与 Web 端 Key 配套的安全密钥。仅在本地服务或 Cloudflare Pages Function 中读取。
AMAP_SECURITY_CODE=

# 可选：使用独立的高德服务代理。默认走本站的 /_AMapService。
AMAP_SERVICE_HOST=

# 可选：本地端口，默认 3000；被占用时启动脚本自动选择空闲端口。
PORT=3000
